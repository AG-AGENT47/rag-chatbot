# Copy this file to .env and fill in your values.
# .env is in .gitignore — never commit real secrets.

# Neon PostgreSQL connection string (from portfolio-store)
NEON_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Voyage AI API key — must match the model used to build knowledge_base embeddings
VOYAGE_API_KEY=pa-...

# LLM provider: "gemini" (default) or "groq"
LLM_PROVIDER=gemini

# Gemini 2.5 Flash — free at https://aistudio.google.com
GEMINI_API_KEY=AIza...

# Groq Llama 3.3 70B — only needed if LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Server port (default: 8080)
PORT=8080

# Cosine distance threshold for topic filter (default: 0.75)
# Queries above this distance are considered off-topic — no LLM call made.
# Increase to be more permissive, decrease to be stricter.
SIMILARITY_THRESHOLD=0.75
