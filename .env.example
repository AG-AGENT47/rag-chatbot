# Copy this file to .env and fill in your values.
# .env is in .gitignore — never commit real secrets.

# Neon PostgreSQL connection string (from portfolio-store)
NEON_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Embeddings ---
# "gemini" (default) or "voyage". MUST match the model that built the stored
# knowledge_base vectors (portfolio-store/scripts/embed.py + migration 005).
EMBED_PROVIDER=gemini

# --- LLM ---
# "groq" (default) or "gemini"
LLM_PROVIDER=groq

# Google AI Studio key — used for BOTH gemini embeddings and the gemini LLM
# fallback. Free, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# Groq Llama 3.3 70B — needed when LLM_PROVIDER=groq (the default)
GROQ_API_KEY=gsk_...

# Voyage AI — only needed for rollback (EMBED_PROVIDER=voyage)
VOYAGE_API_KEY=pa-...

# Comma-separated list of allowed CORS origins (add your Vercel URL in prod)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Server port (default: 8080)
PORT=8080

# Cosine distance threshold for the topic filter (default: 0.75).
# Queries whose best-matching chunk is farther than this are treated as
# off-topic and get a redirect without an LLM call.
SIMILARITY_THRESHOLD=0.75
